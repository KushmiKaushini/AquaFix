# AquaFix Backend Configuration
PROJECT_NAME="AquaFix API"
SECRET_KEY="replace-this-with-a-very-secure-random-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Connection (PostgreSQL with PostGIS)
# Example: postgresql://username:password@localhost:5432/aquafix
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aquafix"

# Google Generative AI (Gemini) API Key
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSyYourGeminiAPIKeyHere"

# CORS Configuration
# Frontend URL for allowed origins
FRONTEND_URL="http://localhost:3000"

# Rate Limiting
# Maximum requests per minute per IP address
RATE_LIMIT_PER_MINUTE=60
